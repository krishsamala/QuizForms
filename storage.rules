rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Diagrams uploaded for quiz questions
    // - Public read access so students can view question diagrams in their exam
    // - Authenticated admin or application write access
    match /diagrams/{quizId}/{diagramFile} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

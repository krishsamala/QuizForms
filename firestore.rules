rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify admin email
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email != null;
    }

    // Quizzes collection
    // - Students can read published quizzes (isAcceptingResponses == true)
    // - Admin can CRUD any quiz
    match /quizzes/{quizId} {
      allow read: if resource.data.isAcceptingResponses == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Attempts collection (Designed for 200+ concurrent students)
    // - Student can create an attempt without requiring Firebase Auth (1 write at start)
    // - Student can submit their attempt if not previously submitted (1 write at submission)
    // - Admin can read and inspect all attempts
    // - Student can read their own attempt by email
    match /attempts/{attemptId} {
      allow create: if true;
      allow update: if resource.data.submittedAt == null;
      allow read: if isAdmin() || 
                     (request.auth != null && resource.data.studentEmail == request.auth.token.email) ||
                     true; // Public read permitted for instant scorecard display on student client
      allow delete: if isAdmin();
    }
  }
}

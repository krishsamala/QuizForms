rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Quizzes collection:
    // Anyone can read quizzes to take them; only authorized admin accounts can create, update, and delete
    match /quizzes/{quizId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && (
        request.auth.token.email in ['sujatasamala3@gmail.com', 'samalaraj2@gmail.com']
      );
    }

    // Attempts collection (200+ concurrent students):
    // Students can create and submit attempts; admins view responses
    match /attempts/{attemptId} {
      allow read, write: if true;
    }
  }
}
